{
  "name": "etoro-trading-mcp",
  "version": "1.0.0",
  "description": "Local TypeScript MCP server for eToro's complete Swagger UI API with configurable toolsets and demo-safe defaults.",
  "license": "MIT",
  "author": "Nikolay Kostadinov",
  "type": "module",
  "bin": {
    "etoro-trading-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "docs/*.md",
    "!docs/internal",
    "INSTALL.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "acquire": "tsx scripts/acquire-openapi.ts",
    "build": "tsc -p tsconfig.build.json",
    "docs:check": "tsx scripts/check-docs.ts && cspell --no-progress --no-summary",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "generate": "tsx scripts/generate.ts",
    "generate:check": "tsx scripts/check-generated.ts",
    "lint": "biome lint .",
    "pack:check": "tsx scripts/check-package.ts",
    "prepack": "npm run build",
    "publication:verify": "tsx scripts/verify-publication.ts",
    "release:notes": "tsx scripts/release-notes.ts",
    "release:validate": "tsx scripts/validate-release.ts",
    "swagger:diff": "tsx scripts/swagger-diff.ts",
    "sync:swagger": "tsx scripts/synchronize-swagger.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:integration && npm run generate:check && npm run docs:check && npm run workflow:check && npm run build && npm run pack:check",
    "workflow:check": "tsx scripts/check-workflows.ts"
  },
  "keywords": [
    "etoro",
    "mcp",
    "model-context-protocol",
    "typescript",
    "nodejs",
    "openapi",
    "trading-api",
    "stock-market-data",
    "demo-trading",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-kostadinov/etoro-trading-mcp.git"
  },
  "homepage": "https://github.com/n-kostadinov/etoro-trading-mcp#readme",
  "bugs": {
    "url": "https://github.com/n-kostadinov/etoro-trading-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^22.0.0",
    "actionlint": "^2.0.6",
    "cspell": "^9.8.0",
    "openapi-types": "^12.1.3",
    "openapi-typescript": "7.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
